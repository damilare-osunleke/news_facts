                                                 \par countries    14,129   34.0  19,915   33.4  25,607   28.6  19,438 (24.1)  24,867   27.9\par                                                                                       \par Argentina       958   54.4   1,125   17.4   1,236    9.9   1,157  (6.4)     914 (21.0)\par                                                                                       \par Brazil        2,987   27.3   4,109   37.6   4,672   13.7   3,513 (24.8)   4,081   16.2\par                                                                                       \par India           968   23.4   1,310   35.4   1,707   30.3   1,524 (10.7)   2,143   40.6\par                                                                                       \par Malaysia        895   32.9   1,477   65.1   1,971   33.5   1,137 (42.3)   1,344   18.1\par                                                                                       \par Thailand        560   23.9   1,006   79.7   1,497   48.8     931 (37.8)   1,368   46.9\par                                                                                       \par Imports                                                                               \par from CIS                                                                              \par countries    22,374   17.8  29,871   33.5  36,607   22.6  21,818 (40.4)  31,607   44.9\par                                                                                       \par Ukraine       9,238   18.1  13,330   44.3  16,254   21.9   9,129 (43.8)  14,041   53.8\par                                                                                       \par Belarus       6,845   19.8   8,879   29.7  10,552   18.8   6,718 (36.3)   9,816   46.1\par                                                                                       \par Kazakhstan    3,840   19.1   4,623   20.4   6,379   38.0   3,693 (42.1)   2,664 (27.9)\par                                    