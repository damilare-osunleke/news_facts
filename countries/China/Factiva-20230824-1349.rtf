ers.com/xyd46v"}}{\fldrslt{\cf2 \uc2 http://link.reuters.com/xyd46v}}}\uc2 \f2 \par  \par     - Global \f28 \b \highlight22\uc2 \f2 currency\f28 \b0 \highlight\uc2 \f2  performance INTERACTIVE GRAPHIC: \f28 {\field{\*\fldinst{HYPERLINK "http://link.reuters.com/cyx46v"}}{\fldrslt{\cf2 \uc2 http://link.reuters.com/cyx46v}}}\uc2 \f2 \par  \par     - China's trade surpluses mainly driven by weak imports\par rather than strong exports. GRAPHIC: \f28 {\field{\*\fldinst{HYPERLINK "http://link.reuters.com/qav68s"}}{\fldrslt{\cf2 \uc2 http://link.reuters.com/qav68s}}}\uc2 \f2 \par  \par     - The yuan resumes appreciating on a trade-weighted basis\par GRAPHIC: \f28 {\field{\*\fldinst{HYPERLINK "http://link.reuters.com/sed74t"}}{\fldrslt{\cf2 \uc2 http://link.reuters.com/sed74t}}}\uc2 \f2 \par     \par     >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>   \par \par  (Reporting by Saikat Chatterjee; Additional reporting by\par Krishna Kumar in SYDNEY; Editing by Shri Navaratnam)\f28 \par \par \uc2 Released: 2014-11-7T03:52:36.000Z   \par \par \uc2 Dokument LBA0000020141107eab7002uv\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw172\pich40\picscaley100\picscalex100\picwgoal2580\pichgoal600
