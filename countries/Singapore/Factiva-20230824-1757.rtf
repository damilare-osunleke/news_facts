ar \uc2  (MORE) Dow Jones Newswires  12-15-98 \par \par \uc2  2156EST \par \par \uc2  1136 4250 \par \par \uc2 Dokument cm00000020010916ducg02uno\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw184\pich22\picscaley100\picscalex100\picwgoal2760\pichgoal330
