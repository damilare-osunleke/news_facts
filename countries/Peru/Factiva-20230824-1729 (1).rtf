ones.com \par \par \uc2  1071 1837 \par \par \uc2 Dokument cm00000020030328dz3s008c5\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw184\pich22\picscaley100\picscalex100\picwgoal2760\pichgoal330
