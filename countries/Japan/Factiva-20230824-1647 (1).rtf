)). \par \par \uc2  (C) Reuters Limited 1999. \par \par \uc2 Dokument lba0000020010907dv6f06gdi\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw172\pich40\picscaley100\picscalex100\picwgoal2580\pichgoal600
