9308FFE4C6FFF4E8FFA535FFBE7C7A7A7ACBCBCBFF9B24858585FFF2E4C1C1C1F2F2F2FFAA45FFCE9CFFE3C5FFE3BEFFE6CDFFEBD4FF921AFF9316FFAD59FF9D
