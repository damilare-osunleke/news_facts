ion. \par \par \uc2  (c) Reuters Limited 1995 \par \par \uc2 Dokument lba0000020011103dr1f089wy\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw184\pich22\picscaley100\picscalex100\picwgoal2760\pichgoal330
