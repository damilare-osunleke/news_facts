ield{\*\fldinst{HYPERLINK "http://www.bcb.gov.br"}}{\fldrslt{\cf2 \uc2 http://www.bcb.gov.br}}}\uc2 \f2 .\par \f28 \par \par \uc2 \f2 \par ((Sao Paulo newsroom, 55 11 248 5532)).\par \f28 \par \par \uc2 \f2 \par (C) Reuters Limited 1999.\par \f28 \par \par \uc2 Dokument lba0000020010909dvas0105x\par }\page {\par\fs20{\*\shppict{\pict\pngblip\picw172\pich40\picscaley100\picscalex100\picwgoal2580\pichgoal600
